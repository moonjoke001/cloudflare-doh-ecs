{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-doh-ecs",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "routes": [
    { "pattern": "doh.lalayunssl.xyz/*", "zone_name": "lalayunssl.xyz" }
  ],
  "kv_namespaces": [
    {
      "binding": "RULES_KV",
      "id": "724104fe6ac049cc9e4996b6f53446d7"
    }
  ],
  "vars": {
    "DOH_PATH": "/doh",
    "DOMESTIC_DOH_URL": "https://dns.alidns.com/dns-query",
    "DOMESTIC_FALLBACK_DOH_URL": "https://doh.pub/dns-query",
    "GLOBAL_DOH_URL": "https://cloudflare-dns.com/dns-query",
    "GLOBAL_FALLBACK_DOH_URL": "https://dns.google/dns-query",
    "DOMESTIC_DOH_ECS": "on",
    "DOMESTIC_FALLBACK_DOH_ECS": "on",
    "GLOBAL_DOH_ECS": "on",
    "GLOBAL_FALLBACK_DOH_ECS": "off",
    "UPSTREAM_TIMEOUT_MS": "1500",
    "HEDGE_DELAY_MS": "800",
    "CACHE_MAX_AGE_S": "300",
    "DEBUG_HEADERS": "on",
    "RELAY_DOMAINS": "chatgpt.com,grok.com,x.com",
    "RELAY_IPV4": "199.168.138.132",
    "X_DOMAINS": "x.com",
    "X_ECH_CONFIG_B64": "AEX+DQBB1QAgACDHrss4Ckg/waeLaVKv5BDPKDQBB6Wme2+a2+FFHi8eVwAEAAEAAQASY2xvdWRmbGFyZS1lY2guY29tAAA=",
    "META_DOMAINS": "instagram.com,facebook.com",
    "META_ECH_CONFIG_B64": "AEj+DQBEAQAgACAdd+scUi0IYFsXnUIU7ko2Nd9+F8M26pAGZVpz/KrWPgAEAAEAAWQVZWNoLXB1YmxpYy5hdG1ldGEuY29tAAA=",
    "ECH_SYNC_URL": "https://edge.1molchuan.top/linuxdo"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
